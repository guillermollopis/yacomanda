# ============================================
# YaComanda — Environment Variables
# Copy this to .env.local and fill in real values
# ============================================

# Database (Neon)
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/yacomanda?sslmode=require

# Auth (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Stripe
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ESENCIAL=price_...
STRIPE_PRICE_PROFESIONAL=price_...
STRIPE_PRICE_NEGOCIO=price_...

# WhatsApp (Meta Cloud API)
WHATSAPP_VERIFY_TOKEN=your_random_secret_token
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxx
WHATSAPP_APP_SECRET=xxxxx
WHATSAPP_PHONE_NUMBER_ID=xxxxx

# AI (all optional — app works without any AI key)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Redis (Upstash)
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...

# Storage (Cloudflare R2)
CLOUDFLARE_R2_ACCOUNT_ID=...
CLOUDFLARE_R2_ACCESS_KEY=...
CLOUDFLARE_R2_SECRET_KEY=...
CLOUDFLARE_R2_BUCKET=yacomanda

# Email (Resend)
RESEND_API_KEY=re_...
ADMIN_EMAIL=your-admin@email.com
FROM_EMAIL=YaComanda <noreply@yacomanda.com>

# Meta Embedded Signup (WhatsApp self-service connection)
NEXT_PUBLIC_FACEBOOK_APP_ID=your_meta_app_id
NEXT_PUBLIC_FACEBOOK_CONFIG_ID=your_embedded_signup_config_id

# Analytics (optional — works without it)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
